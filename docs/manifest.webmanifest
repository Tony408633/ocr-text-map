{
  "name": "纸伴 · 陪你读书",
  "short_name": "纸伴",
  "id": "./",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./#/welcome",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#f4f2ea",
  "theme_color": "#0f6b58",
  "description": "语音优先的纸书阅读伙伴：扫描书页、逐行朗读、记录批注，全部在本机处理。",
  "categories": [
    "books",
    "education",
    "accessibility"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "扫描书页",
      "short_name": "扫描",
      "url": "./#/setup",
      "description": "打开相机扫描一页纸书"
    },
    {
      "name": "继续阅读",
      "short_name": "阅读",
      "url": "./#/reading",
      "description": "回到上次读到的位置"
    },
    {
      "name": "我的批注",
      "short_name": "批注",
      "url": "./#/notes",
      "description": "查看和回听已保存的批注"
    }
  ]
}
